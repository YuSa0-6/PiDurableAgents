{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Packages that no source file imports, kept on purpose.
  "ignoreDependencies": [
    // Listed so vite.config.ts and src/tests/vitest.config.ts can dedupe it:
    // the harness and the app must share one copy of pi's module state.
    "@earendil-works/pi-telemetry",
    // pi-ai and pi-schema need exactly typebox 1.3.27 (see dependabot.yml).
    "typebox",
    // A peer dependency of agents' Pi harness (pi-durable needs it at run time).
    "@earendil-works/chord",
    // Peer dependencies of @cloudflare/computer.
    "@platformatic/vfs",
    "zod",
    // CLIs, run as `pnpm exec cf` and `pnpm exec wrangler` (see README "ツールチェーン").
    // Wrangler is only for what cf beta lacks: secrets and tail.
    "cf",
    "wrangler"
  ]
}
