{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "d1agents-pi-durable",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    // The AI Gateway that holds the OpenRouter key (BYOK).
    "AI_GATEWAY_ID": "d1agents",
    // GitHub App for the github extension (push and pull requests). The IDs are
    // not secret; the private key is a secret: `wrangler secret put GITHUB_APP_PRIVATE_KEY`.
    // The tools stay off until the IDs, the key and API_TOKEN are all set.
    "GITHUB_APP_ID": "",
    "GITHUB_APP_INSTALLATION_ID": "",
    // Repositories the agent may push to, comma-separated owner/name.
    "GITHUB_REPOS": "YuSa0-6/D1Agents"
  },
  // `exec` runs JavaScript in Dynamic Workers minted through this.
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "PiAgent",
        "class_name": "PiAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiAgent"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
