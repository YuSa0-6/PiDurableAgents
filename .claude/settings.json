{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    },
    "yomiyasu-mini": {
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu-mini"
      }
    }
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true,
    "yomiyasu-mini@yomiyasu-mini": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.ts\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.ts\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
