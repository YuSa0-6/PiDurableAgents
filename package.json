{
  "name": "d1agents-pi-durable",
  "description": "Experimental: pi-durable hosted on a Durable Object as an example-local PiHarness on a driver",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "start": "vp dev",
    "build": "vp build",
    "deploy": "vp build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types env.d.ts --include-runtime false",
    "test": "pnpm test:workers && pnpm test:ui",
    "test:workers": "vp test run --config src/tests/vitest.config.ts",
    "test:ui": "vp test run --config src/tests/ui/vitest.config.ts",
    "deploy:embedded": "vp build && node scripts/embed-ui.mjs && wrangler deploy -c dist/d1agents_pi_durable/wrangler.embedded.json",
    "check": "vp check"
  },
  "dependencies": {
    "@cloudflare/computer": "^0.10.0",
    "@cloudflare/kumo": "^2.6.0",
    "@earendil-works/chord": "~1.5.0",
    "@earendil-works/pi-ai": "~1.5.0",
    "@earendil-works/pi-durable": "~1.5.0",
    "@earendil-works/pi-schema": "~1.5.0",
    "@earendil-works/pi-telemetry": "~1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@platformatic/vfs": "^0.5.0",
    "agents": "^0.33.0",
    "hono": "^4.13.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "typebox": "1.3.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cf": "1.0.0-beta.27",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.145.0"
  }
}
