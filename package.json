{
  "name": "d1agents-pi-durable",
  "version": "0.0.0",
  "private": true,
  "description": "Pi Durable agent on Cloudflare Workers + Durable Objects, driven over HTTP and remote MCP",
  "workspaces": {
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
      "vitest": "5.1.0",
      "vite-plus": "1.6.0"
    }
  },
  "type": "module",
  "scripts": {
    "start": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "cf workers types && vp check --no-fmt --no-lint",
    "types": "cf workers types",
    "test": "vp test run --config src/tests/vitest.config.ts",
    "check": "vp check",
    "prepare": "vp hooks enable",
    "verify:secrets": "sh scripts/verify/secrets.sh all",
    "verify:workflows": "sh scripts/verify/workflows.sh",
    "verify:dead-code": "fallow audit --base origin/main",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@cloudflare/computer": "^0.11.2",
    "@earendil-works/chord": "~1.6.0",
    "@earendil-works/pi-ai": "~1.6.0",
    "@earendil-works/pi-codemode": "~1.6.0",
    "@earendil-works/pi-durable": "~1.6.0",
    "@earendil-works/pi-schema": "~1.6.0",
    "@earendil-works/pi-telemetry": "~1.6.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@platformatic/vfs": "^0.5.0",
    "agents": "^0.34.0",
    "hono": "^4.13.18",
    "typebox": "1.3.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-beta.32",
    "fallow": "^3.45.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
