{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "PI_HARNESS_TEST", "class_name": "PiHarnessTestObject" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PiHarnessTestObject"] }]
}
